    "Open TethrX and pair with your computer, then share again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie TethrX, koppeln Sie mit Ihrem Computer und teilen Sie erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre TethrX y enlaza con tu ordenador; después, comparte de nuevo."
