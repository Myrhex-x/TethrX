        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si Grok está trabajando en tu ordenador y si te necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le Grok de votre ordinateur travaille, et s'il a besoin de vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se Grok sta lavorando sul tuo computer e se ha bisogno di te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータの Grok が作業中かどうか、確認が必要かどうか。"
