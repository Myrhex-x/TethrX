            "value": "Impossible de joindre cet ordinateur. Vérifiez l'adresse et que son bridge est lancé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere quel computer. Controlla l'indirizzo e che il suo bridge sia in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのコンピュータに接続できませんでした。アドレスと、ブリッジが実行中かどうかを確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar esse computador. Verifique o endereço e se o bridge dele está em execução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到那台电脑。请检查地址，并确认其桥接正在运行。"
          }
        }
      }
    },
    "Couldn't reach the computer to stop the turn — it may still be running.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Computer war zum Stoppen nicht erreichbar. Der Turn läuft evtl. noch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach the computer to stop the turn. It may still be running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con el ordenador para detener el turno. Puede que siga en marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
