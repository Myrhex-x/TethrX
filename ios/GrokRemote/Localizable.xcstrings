        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer une branche de cette session. Vérifiez la connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile ramificare questa sessione. Controlli la connessione e riprovi."
