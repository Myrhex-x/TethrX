    "%@ didn't answer — staying on the current computer. (%@)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat nicht geantwortet. Der aktuelle Computer bleibt verbunden. (%2$@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't answer. Staying on the current computer. (%@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no respondió. Se mantiene el ordenador actual. (%2$@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ n'a pas répondu. L'ordinateur actuel reste connecté. (%2$@)"
          }
