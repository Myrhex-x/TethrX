    "This needs bridge 0.1.14 or newer — update it with npm i -g tethrx-bridge.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür ist Bridge 0.1.14 oder neuer nötig. Aktualisieren Sie sie mit npm i -g tethrx-bridge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This needs bridge 0.1.14 or newer. Update it with npm i -g tethrx-bridge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto necesita el bridge 0.1.14 o posterior. Actualízalo con npm i -g tethrx-bridge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite le bridge 0.1.14 ou plus récent. Mettez-le à jour avec npm i -g tethrx-bridge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve il bridge 0.1.14 o successivo. Aggiornalo con npm i -g tethrx-bridge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにはブリッジ 0.1.14 以降が必要です。npm i -g tethrx-bridge でアップデートしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto requer o bridge 0.1.14 ou mais recente. Atualize com npm i -g tethrx-bridge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能需要桥接 0.1.14 或更新版本。用 npm i -g tethrx-bridge 更新。"
          }
        }
      }
    },
    "This one runs a long, expensive task that keeps going after you close the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Befehl startet eine lange, teure Aufgabe, die auch nach dem Schließen der App weiterläuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto ejecuta una tarea larga y costosa que continúa aunque cierres la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celle-ci lance une tâche longue et coûteuse qui continue après la fermeture de l'application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo avvia un'operazione lunga e costosa che prosegue anche dopo la chiusura dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコマンドは、アプリを閉じた後も実行が続く、時間とコストのかかる処理を開始します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este executa uma tarefa longa e cara, que continua rodando depois que você fecha o app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条命令会执行一项耗时且开销较大的任务，关闭 App 后它仍会继续运行。"
          }
        }
      }
    },
    "This phone is already paired with %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon ist bereits mit %@ gekoppelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono ya está enlazado con %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone est déjà appairé avec %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono è già associato a %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末はすでに %@ とペアリングされています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone já está pareado com %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台手机已与 %@ 配对。"
          }
        }
      }
    },
    "This phone is already paired. Reconnect to the same computer — or set it up again below.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone ist bereits gekoppelt. Verbinden Sie sich erneut mit demselben Computer, oder richten Sie unten alles neu ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone is already paired. Reconnect to the same computer, or set it up again below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono ya está enlazado. Reconéctate al mismo ordenador, o configúralo de nuevo abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone est déjà appairé. Reconnectez-vous au même ordinateur, ou refaites la configuration ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono è già abbinato. Riconnettiti allo stesso computer, oppure configuralo di nuovo qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone はペアリング済みです。同じコンピュータに再接続するか、下からもう一度設定してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone já está pareado. Reconecte-se ao mesmo computador, ou configure de novo abaixo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台手机已配对。可重新连接同一台电脑，或在下方重新设置。"
