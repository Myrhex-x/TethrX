    },
    "These steps all happen on the computer you want to control. Nothing extra is needed on this phone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Schritte finden alle auf dem Computer statt, den Sie steuern möchten. Auf diesem Telefon wird nichts zusätzlich benötigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos estos pasos ocurren en el ordenador que quieres controlar. En este teléfono no hace falta nada más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes ces étapes se passent sur l'ordinateur que vous voulez piloter. Rien d'autre n'est nécessaire sur ce téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi passaggi avvengono tutti sul computer che vuoi controllare. Su questo telefono non serve altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの手順はすべて、操作したいコンピュータ側で行います。この端末に追加で必要なものはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos esses passos acontecem no computador que você quer controlar. Neste telefone não é preciso mais nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些步骤都在你要控制的那台电脑上完成。这台手机上不需要再装任何东西。"
          }
        }
      }
    },
