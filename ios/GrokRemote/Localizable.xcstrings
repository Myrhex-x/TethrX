          }
        }
      }
    },
    "That decision did not reach your computer. Open the session and answer it there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Entscheidung hat deinen Computer nicht erreicht. Öffne die Sitzung und antworte dort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa decisión no llegó a tu ordenador. Abre la sesión y respóndela ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette décision n'est pas parvenue à votre ordinateur. Ouvrez la session et répondez depuis celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa decisione non è arrivata al tuo computer. Apri la sessione e rispondi da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作はお使いのコンピュータに届きませんでした。セッションを開いて、そちらで応答してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa decisão não chegou ao seu computador. Abra a sessão e responda por lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该决定没有送达你的电脑。请打开该会话，在那里作出回应。"
          }
        }
      }
    },
    "That didn't go through — check the bridge log for details.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat nicht geklappt. Details stehen im Bridge-Log."
          }
        },
