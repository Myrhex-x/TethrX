    },
    "Your computer needs bridge 0.1.15 or newer for daily usage. Update it with: npm i -g tethrx-bridge": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Computer benötigt bridge 0.1.15 oder neuer für die Tagesnutzung. Aktualisieren mit: npm i -g tethrx-bridge"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su ordenador necesita bridge 0.1.15 o posterior para el uso diario. Actualícelo con: npm i -g tethrx-bridge"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ordinateur nécessite bridge 0.1.15 ou plus récent pour la consommation quotidienne. Mettez-le à jour avec : npm i -g tethrx-bridge"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per l'utilizzo giornaliero il suo computer richiede bridge 0.1.15 o versione successiva. Lo aggiorni con: npm i -g tethrx-bridge"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日別の使用状況にはbridge 0.1.15以降が必要です。次のコマンドで更新してください: npm i -g tethrx-bridge"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu computador precisa do bridge 0.1.15 ou mais recente para o uso diário. Atualize com: npm i -g tethrx-bridge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看每日用量需要 bridge 0.1.15 或更高版本。请用以下命令更新：npm i -g tethrx-bridge"
          }
        }
      }
    },
    "Your computer rejected the pairing token. Re-pair in TethrX.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Computer hat den Kopplungs-Token abgelehnt. Koppeln Sie in TethrX erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su ordenador rechazó el token de emparejamiento. Vuelva a emparejar en TethrX."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ordinateur a rejeté le jeton d'appairage. Refaites l'appairage dans TethrX."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo computer ha rifiutato il token di abbinamento. Ripeta l'abbinamento in TethrX."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パソコンがペアリングトークンを拒否しました。TethrXでペアリングし直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu computador rejeitou o token de pareamento. Refaça o pareamento no TethrX."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的电脑拒绝了配对令牌。请在 TethrX 中重新配对。"
          }
        }
      }
    },
    "Your computer returned an error (status %lld).": {
