    "Sends a prompt to your most recent Grok Build session, and leaves it running on your computer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet einen Prompt an Ihre neueste Grok-Build-Session und lässt sie auf Ihrem Computer weiterlaufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un prompt a tu sesión más reciente de Grok Build y la deja ejecutándose en tu ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie un prompt à votre session Grok Build la plus récente et la laisse tourner sur votre ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un prompt alla tua sessione Grok Build più recente e la lascia in esecuzione sul tuo computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の Grok Build セッションにプロンプトを送信し、そのままコンピュータ上で実行を続けさせます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia um prompt para a sua sessão mais recente do Grok Build e a deixa em execução no seu computador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将提示词发送到你最近的 Grok Build 会话，并让它在你的电脑上继续运行。"
          }
        }
      }
    },
    "Sent to %@. I'll notify you when Grok is done.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An %@ gesendet. Ich melde mich, wenn Grok fertig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado a %@. Te avisaré cuando Grok termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyé à %@. Je vous préviendrai quand Grok aura terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviato a %@. Riceverai una notifica quando Grok avrà finito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に送信しました。Grok が完了したらお知らせします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado para %@. Você será avisado quando o Grok terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送到 %@。Grok 完成后我会通知你。"
          }
        }
      }
    },
