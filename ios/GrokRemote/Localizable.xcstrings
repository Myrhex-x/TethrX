    "Update the bridge (npm i -g tethrx-bridge) and reconnect — the app upgrades to pinned HTTPS automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie die Bridge (npm i -g tethrx-bridge) und verbinden Sie sich erneut. Die App wechselt automatisch zu gepinntem HTTPS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update the bridge (npm i -g tethrx-bridge) and reconnect. The app upgrades to pinned HTTPS automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza el bridge (npm i -g tethrx-bridge) y reconecta. La app pasa automáticamente a HTTPS con certificado anclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour le bridge (npm i -g tethrx-bridge) et reconnectez-vous. L'app passe automatiquement en HTTPS épinglé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna il bridge (npm i -g tethrx-bridge) e riconnettiti. L'app passa automaticamente a HTTPS con pinning."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブリッジをアップデート（npm i -g tethrx-bridge）して再接続してください。アプリは自動的にピン留め付き HTTPS へ切り替わります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
