    "// couldn't load the diff — check the connection and try again": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "// Diff konnte nicht geladen werden, Verbindung prüfen und erneut versuchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "// couldn't load the diff, check the connection and try again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "// no se pudo cargar el diff, comprueba la conexión y reinténtalo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "// impossible de charger le diff, vérifiez la connexion et réessayez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "// impossibile caricare il diff, controlla la connessione e riprova"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "// 差分を読み込めませんでした。接続を確認して再試行してください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "// não foi possível carregar o diff, verifique a conexão e tente de novo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "// 无法加载差异，请检查连接后重试"
          }
        }
      }
    },
