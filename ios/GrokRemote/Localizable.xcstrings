          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'era nessuna attività da inviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信するタスクがありませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
