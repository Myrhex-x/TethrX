    "Couldn't branch this session — check the connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sitzung konnte nicht verzweigt werden. Prüfen Sie die Verbindung und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't branch this session. Check the connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo ramificar esta sesión. Compruebe la conexión e inténtelo de nuevo."
