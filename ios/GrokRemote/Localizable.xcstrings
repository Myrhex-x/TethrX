    "Use this if Grok has stopped responding. It ends the stuck turn and keeps the conversation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende dies, wenn Grok nicht mehr reagiert. Die festhängende Aufgabe wird beendet, die Unterhaltung bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Úsalo si Grok ha dejado de responder. Termina la tarea bloqueada y conserva la conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À utiliser si Grok ne répond plus. Cela met fin à la tâche bloquée et conserve la conversation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa questa opzione se Grok non risponde più. Interrompe l'attività bloccata e mantiene la conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Grokが応答しなくなった場合に使用します。止まっているタスクを終了し、会話はそのまま残します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use isto se o Grok parou de responder. Encerra a tarefa travada e mantém a conversa."
          }
