    "That approval was no longer pending — grok isn't waiting on it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Genehmigung stand nicht mehr aus. Grok wartet nicht darauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That approval was no longer pending. Grok isn't waiting on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa aprobación ya no estaba pendiente. Grok no la está esperando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette approbation n'était plus en attente. Grok ne l'attend pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quell'approvazione non era più in attesa. Grok non la sta aspettando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その承認はすでに保留中ではありません。grok は応答を待っていません。"
          }
        },
        "pt-BR": {
