    "This session starts with a summary of the previous conversation. Grok receives it automatically with your first message — nothing to paste.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Session startet mit einer Zusammenfassung des vorherigen Gesprächs. Grok erhält sie automatisch mit deiner ersten Nachricht. Nichts einzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session starts with a summary of the previous conversation. Grok receives it automatically with your first message. Nothing to paste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión empieza con un resumen de la conversación anterior. Grok lo recibe automáticamente con tu primer mensaje. Nada que pegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session démarre avec un résumé de la conversation précédente. Grok le reçoit automatiquement avec votre premier message. Rien à coller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa sessione parte con un riepilogo della conversazione precedente. Grok lo riceve automaticamente col tuo primo messaggio. Niente da incollare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションは前の会話の要約付きで始まります。最初のメッセージと一緒にGrokへ自動的に送られます。貼り付けは不要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sessão começa com um resumo da conversa anterior. O Grok o recebe automaticamente com sua primeira mensagem. Nada para colar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话以上一段对话的摘要开始。Grok 会随你的第一条消息自动收到它。无需粘贴。"
          }
        }
      }
    },
