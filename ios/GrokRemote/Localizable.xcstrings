    "Your computer stopped offering a secure connection. Pair again from its pairing page to continue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Computer bietet keine sichere Verbindung mehr an. Koppele erneut über seine Kopplungsseite, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ordenador dejó de ofrecer una conexión segura. Vuelve a vincularlo desde su página de vinculación para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ordinateur ne propose plus de connexion sécurisée. Relancez l'appairage depuis sa page dédiée pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo computer non offre più una connessione sicura. Ripeti l'abbinamento dalla sua pagina di abbinamento per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのコンピュータが安全な接続を提供しなくなりました。続けるには、コンピュータのペアリングページからもう一度ペアリングしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu computador deixou de oferecer uma conexão segura. Refaça o pareamento na página de pareamento dele para continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的电脑不再提供安全连接。请在它的配对页面重新配对以继续。"
          }
        }
      }
    },
    "Your computer's security certificate changed. Pair again from its pairing page to continue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sicherheitszertifikat deines Computers hat sich geändert. Koppele erneut über seine Kopplungsseite, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El certificado de seguridad de tu ordenador ha cambiado. Vuelve a vincularlo desde su página de vinculación para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de sécurité de votre ordinateur a changé. Relancez l'appairage depuis sa page dédiée pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il certificato di sicurezza del tuo computer è cambiato. Ripeti l'abbinamento dalla sua pagina di abbinamento per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのコンピュータのセキュリティ証明書が変更されました。続けるには、コンピュータのペアリングページからもう一度ペアリングしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O certificado de segurança do seu computador mudou. Refaça o pareamento na página de pareamento dele para continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你电脑的安全证书已更改。请在它的配对页面重新配对以继续。"
          }
        }
      }
    },
