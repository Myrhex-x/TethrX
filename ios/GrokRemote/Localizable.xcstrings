    "The bridge also installs this on its own once no session is running.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bridge installiert das auch selbst, sobald keine Session mehr läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bridge también lo instala por sí solo cuando no hay ninguna sesión en curso."
