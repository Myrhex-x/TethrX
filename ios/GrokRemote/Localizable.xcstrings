    "The bridge is running": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bridge läuft"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bridge está en ejecución"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bridge est lancé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bridge è in esecuzione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブリッジは起動済み"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bridge está em execução"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥接正在运行"
          }
        }
      }
    },
    "The bridge is the small helper program running on your computer — this phone talks only to it, never to a cloud.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bridge ist das kleine Hilfsprogramm auf deinem Computer. Dieses Telefon spricht nur mit ihr, nie mit einer Cloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge is the small helper program running on your computer. This phone talks only to it, never to a cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bridge es el pequeño programa auxiliar que corre en tu ordenador. Este teléfono habla solo con él, nunca con una nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bridge est le petit programme d'assistance qui tourne sur votre ordinateur. Ce téléphone ne parle qu'à lui, jamais à un cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bridge è il piccolo programma di supporto che gira sul tuo computer. Questo telefono parla solo con lui, mai con un cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブリッジはコンピュータ上で動く小さな補助プログラムです。この電話はブリッジとだけ通信し、クラウドとは通信しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bridge é o pequeno programa auxiliar rodando no seu computador. Este telefone fala apenas com ele, nunca com uma nuvem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge 是运行在你电脑上的小型辅助程序。这部手机只与它通信，绝不连接云端。"
          }
        }
      }
    },
    "The bridge runs on Node.js 20 or newer. Install it from nodejs.org if you don't already have it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bridge läuft auf Node.js 20 oder neuer. Installieren Sie es von nodejs.org, falls noch nicht vorhanden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bridge funciona con Node.js 20 o posterior. Instálalo desde nodejs.org si aún no lo tienes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bridge fonctionne avec Node.js 20 ou plus récent. Installez-le depuis nodejs.org si vous ne l'avez pas déjà."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bridge richiede Node.js 20 o successivo. Installalo da nodejs.org se non ce l'hai già."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブリッジは Node.js 20 以降で動作します。まだの場合は nodejs.org からインストールしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bridge funciona com Node.js 20 ou mais recente. Instale-o em nodejs.org se você ainda não o tiver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥接需要 Node.js 20 或更新版本。如果尚未安装，请从 nodejs.org 安装。"
          }
        }
      }
    },
    "The task runs in this session — its folder, effort, and approval settings apply.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe läuft in dieser Session. Deren Ordner, Aufwand und Genehmigungseinstellungen gelten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task runs in this session. Its folder, effort, and approval settings apply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea se ejecuta en esta sesión. Se aplican su carpeta, su esfuerzo y sus ajustes de aprobación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche s'exécute dans cette session. Son dossier, son effort et ses approbations s'appliquent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attività viene eseguita in questa sessione. Si applicano la sua cartella, lo sforzo e le impostazioni di approvazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクはこのセッション内で実行されます。セッションのフォルダ、推論強度、承認設定が適用されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa é executada nesta sessão. A pasta, o esforço e os ajustes de aprovação dela se aplicam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务在此会话中运行。沿用该会话的文件夹、推理强度和批准设置。"
          }
        }
      }
    },
    "The turn that is running now will end. The conversation is kept, and your next message carries on from it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die laufende Aufgabe wird beendet. Die Unterhaltung bleibt erhalten, und deine nächste Nachricht knüpft daran an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea en curso terminará. La conversación se conserva y tu siguiente mensaje continúa a partir de ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche en cours va s'arrêter. La conversation est conservée et votre prochain message reprendra à partir de là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attività attualmente in corso verrà interrotta. La conversazione viene mantenuta e il prossimo messaggio riprenderà da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のタスクは終了します。会話は保持され、次のメッセージはその続きから始まります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa em andamento será encerrada. A conversa é mantida, e sua próxima mensagem continua de onde ela parou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前正在运行的任务会结束。对话会保留，你的下一条消息将从这里继续。"
          }
        }
      }
    },
    "The working tree is clean%@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Arbeitsverzeichnis ist sauber%@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El árbol de trabajo está limpio%@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arbre de travail est propre%@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'albero di lavoro è pulito%@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業ツリーはクリーンです%@。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A árvore de trabalho está limpa%@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区是干净的%@。"
          }
        }
      }
    },
    "Then restart the bridge and reconnect. Chat keeps working meanwhile; the newest features need the update.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie danach die Bridge neu und verbinden Sie sich erneut. Der Chat funktioniert währenddessen weiter; die neuesten Funktionen brauchen das Update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después reinicia el bridge y reconecta. El chat sigue funcionando mientras tanto; las funciones más recientes necesitan la actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis redémarrez le bridge et reconnectez-vous. La discussion continue de fonctionner ; les nouveautés nécessitent la mise à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi riavvia il bridge e riconnettiti. Nel frattempo la chat continua a funzionare; le funzioni più recenti richiedono l'aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのあとブリッジを再起動して、再接続してください。その間もチャットはそのまま使えますが、最新の機能にはアップデートが必要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois reinicie o bridge e reconecte. O chat continua funcionando enquanto isso; os recursos mais novos precisam da atualização."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后重启桥接并重新连接。此期间聊天仍可正常使用；最新功能需要此更新。"
          }
        }
      }
    },
    "Then use the ••• button on any session to move it in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzen Sie dann die •••-Taste einer Session, um sie hierher zu verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego usa el botón ••• de cualquier sesión para moverla aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez ensuite le bouton ••• d'une session pour l'y déplacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi usa il pulsante ••• su una sessione per spostarla qui dentro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのあと、任意のセッションの ••• ボタンからこのフォルダに移動できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois use o botão ••• em qualquer sessão para movê-la para cá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后在任意会话上使用 ••• 按钮将其移入。"
          }
        }
      }
    },
    "There was no task to send.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gab keine Aufgabe zu senden."
          }
        },
        "es": {
