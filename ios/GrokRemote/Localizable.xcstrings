          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più alto pensa più a lungo e consuma più token; Auto lascia decidere a Grok."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高いほど長く考え、トークンを多く消費します。自動ではGrokが判断します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais alto pensa por mais tempo e gasta mais tokens; Auto deixa o Grok decidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "越高思考越久、消耗越多 token；自动则由 Grok 决定。"
          }
        }
      }
    },
    "Higher thinks longer and costs more tokens. High is Grok's default.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höher denkt länger und kostet mehr Tokens. Hoch ist Groks Standard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más alto piensa más tiempo y gasta más tokens. Alto es el valor por defecto de Grok."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus haut = réflexion plus longue et plus de jetons. Élevé est la valeur par défaut de Grok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più alto pensa più a lungo e consuma più token. Alto è il valore predefinito di Grok."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高いほど長く考え、トークンを多く消費します。既定は「高」です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais alto pensa por mais tempo e gasta mais tokens. Alto é o padrão do Grok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "越高思考越久、消耗越多 token。默认为高。"
          }
        }
      }
    },
    "How every new session starts. Nothing here is locked in — the same controls sit above the message box inside each session.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So startet jede neue Session. Nichts ist festgelegt. Dieselben Regler liegen in jeder Session über dem Eingabefeld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How every new session starts. Nothing here is locked in. The same controls sit above the message box inside each session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo empieza cada nueva sesión. Nada queda fijado. Los mismos controles están sobre el cuadro de mensaje dentro de cada sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment démarre chaque nouvelle session. Rien n'est figé. Les mêmes réglages sont au-dessus de la zone de message dans chaque session."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come parte ogni nuova sessione. Niente è vincolante. Gli stessi controlli stanno sopra la casella dei messaggi in ogni sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいセッションの初期設定です。固定ではありません。各セッションのメッセージ欄の上に同じ設定があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como cada nova sessão começa. Nada fica travado. Os mesmos controles ficam acima da caixa de mensagem em cada sessão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个新会话的初始设置。这里没有锁定。每个会话的消息框上方都有同样的控件。"
          }
        }
      }
    },
