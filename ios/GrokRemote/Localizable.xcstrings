    },
    "TethrX drives Grok Build — xAI's terminal coding agent. Install it on your computer with one command:": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TethrX steuert Grok Build, den Terminal-Coding-Agenten von xAI. Installieren Sie ihn mit einem Befehl auf Ihrem Computer:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TethrX drives Grok Build, xAI's terminal coding agent. Install it on your computer with one command:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TethrX controla Grok Build, el agente de programación en terminal de xAI. Instálalo en tu ordenador con un solo comando:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TethrX pilote Grok Build, l'agent de programmation en terminal de xAI. Installez-le sur votre ordinateur avec une seule commande :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TethrX pilota Grok Build, l'agente di coding da terminale di xAI. Installalo sul tuo computer con un solo comando:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TethrX は、xAI のターミナルコーディングエージェント「Grok Build」を操作します。コマンド 1 つでコンピュータにインストールできます："
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TethrX controla o Grok Build, o agente de programação para terminal da xAI. Instale-o no seu computador com um único comando:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TethrX 操控 Grok Build，xAI 的终端编程智能体。用一条命令在你的电脑上安装它："
          }
        }
      }
    },
    "TethrX drives Grok Build, xAI's terminal coding agent, on a computer you own. Install it there with one command:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TethrX steuert Grok Build, den Terminal-Coding-Agenten von xAI, auf einem Computer, der Ihnen gehört. Installieren Sie ihn dort mit einem einzigen Befehl:"
          }
