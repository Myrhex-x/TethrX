    "Removes it from this phone and drops its pairing token. Pair again anytime from the computer's QR code.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt ihn von diesem Telefon und löscht sein Kopplungs-Token. Jederzeit über den QR-Code des Computers neu koppelbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo elimina de este teléfono y borra su token de emparejamiento. Vuelve a emparejar cuando quieras desde el código QR del ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le supprime de ce téléphone et efface son jeton de jumelage. Jumelez à nouveau à tout moment depuis le code QR de l'ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo rimuove da questo telefono ed elimina il token di abbinamento. Puoi riabbinarlo in qualsiasi momento dal codice QR del computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この電話から削除し、ペアリングトークンを破棄します。コンピュータのQRコードからいつでも再ペアリングできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove do telefone e apaga o token de pareamento. Pareie novamente a qualquer momento pelo código QR do computador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从这部手机中移除并删除其配对令牌。随时可通过电脑上的二维码重新配对。"
          }
        }
      }
    },
    "Removes its conversation from the computer too. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt auch das Gespräch vom Computer. Kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También elimina su conversación del ordenador. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime aussi sa conversation de l'ordinateur. Action irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove anche la conversazione dal computer. Non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータ上の会話も削除されます。元に戻せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também remove a conversa do computador. Isso não pode ser desfeito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也会从电脑上删除其对话。此操作无法撤销。"
          }
        }
      }
    },
