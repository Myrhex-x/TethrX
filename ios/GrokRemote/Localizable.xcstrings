    "You're looking at sample data. Nothing here reaches a real computer, and nothing you type is sent anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sehen Beispieldaten. Nichts davon erreicht einen echten Computer, und nichts, was Sie eingeben, wird gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está viendo datos de ejemplo. Nada de esto llega a un ordenador real y nada de lo que escriba se envía a ninguna parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous consultez des données d'exemple. Rien ici n'atteint un ordinateur réel, et rien de ce que vous saisissez n'est envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta visualizzando dati di esempio. Nulla raggiunge un computer reale e nulla di ciò che digita viene inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルデータを表示しています。実際のコンピュータには何も届かず、入力した内容もどこにも送信されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está vendo dados de exemplo. Nada aqui chega a um computador real e nada do que você digitar é enviado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您看到的是示例数据。这里的内容不会连接真实电脑，您输入的任何内容也不会被发送。"
          }
        }
      }
    },
